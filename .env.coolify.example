# =============================================================================
# Coolify environment template for iCloud Checker
# Copy each variable into the Coolify UI (Application -> Environment Variables).
# Do NOT commit real secret values — this file is a template only.
# =============================================================================

APP_NAME="iCloud Checker"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example.com

# Generate once with `php artisan key:generate --show` and paste the value.
APP_KEY=

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (Coolify managed MySQL/MariaDB) -------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=icloud_checker
DB_USERNAME=icloud
DB_PASSWORD=change-me

# --- Cache / Session / Queue ------------------------------------------------
# Use `redis` if you attach a Redis service, otherwise `database` (safe default).
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# If you attach a Redis service in Coolify:
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=null

# --- Runtime toggles honored by docker/entrypoint.sh + supervisord ----------
RUN_MIGRATIONS=true
RUN_QUEUE_WORKER=true
RUN_SCHEDULER=true

# --- Trusted proxies (Coolify sits behind Traefik) --------------------------
TRUSTED_PROXIES=*

# --- Third-party integrations (rotate before real use) ----------------------
IFREEICLOUD_KEY=
IFREEICLOUD_USERNAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example.com/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://your-domain.example.com/auth/facebook/callback

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="iCloud Checker"

# --- First-boot admin --------------------------------------------------------
# `php artisan admin:ensure` runs at container start. If ADMIN_PASSWORD is
# empty, a strong random password is generated and logged ONCE to stdout —
# copy it from the deploy logs. The admin is forced to change on first login.
ADMIN_EMAIL=admin@your-domain.example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=
