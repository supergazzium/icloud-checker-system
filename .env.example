APP_NAME="iCloud Checker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=icloud_checker
DB_USERNAME=root
DB_PASSWORD=

IFREEICLOUD_KEY=your_ifreeicloud_api_key
IFREEICLOUD_USERNAME=
IFREEICLOUD_API_URL=https://api.ifreeicloud.co.uk
IFREEICLOUD_USD_TO_THB=36.00
IFREEICLOUD_DEFAULT_MARKUP=2.5

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# First-boot admin. If ADMIN_PASSWORD is empty, `admin:ensure` generates a
# random one and prints it once. Admin is forced to change on first login.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=
